<h1>ログイン</h1>

<p>住民・世話人・市の職員の方は、お持ちのアカウントでログインしてください。アカウントの種類に合わせた画面が表示されます。</p>

<% if alert = flash[:alert] %>
  <div style="color: red;"><%= alert %></div>
<% end %>

<% if notice = flash[:notice] %>
  <div style="color: green;"><%= notice %></div>
<% end %>

<%= form_with url: session_path do |form| %>
  <div>
    <%= form.label :email_address, "メールアドレス" %><br>
    <%= form.email_field :email_address, required: true, autofocus: true,
          autocomplete: "username", value: params[:email_address] %>
  </div>

  <div>
    <%= form.label :password, "パスワード" %><br>
    <%= form.password_field :password, required: true,
          autocomplete: "current-password", maxlength: 72 %>
  </div>

  <%= form.submit "ログイン" %>
<% end %>

<%= link_to "パスワードを忘れた方", new_password_path %>

<section>
  <h2>ログインせずに見る</h2>
  <p>猫台帳を見るだけなら、ログインは不要です。</p>
  <%= link_to "ログインせずに猫台帳一覧を見る", cats_path %>
</section>
